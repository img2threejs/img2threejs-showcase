{
  "name": "img2threejs-showcase",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "check:donate": "node scripts/check-donate-integrity.mjs",
    "prebuild": "npm run check:donate",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "new-demo": "node scripts/new-showcase.mjs",
    "qa:export:list": "node scripts/qa-export-matrix.mjs --list",
    "qa:export:matrix": "node scripts/qa-export-matrix.mjs",
    "star-history": "node scripts/generate-star-history.mjs",
    "dev:iphone-duo": "vite --config vite.iphone-duo.config.ts",
    "build:iphone-duo": "tsc --noEmit -p tsconfig.iphone-duo.json && vite build --config vite.iphone-duo.config.ts",
    "preview:iphone-duo": "vite preview --config vite.iphone-duo.config.ts"
  },
  "dependencies": {
    "meshoptimizer": "~0.18.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
