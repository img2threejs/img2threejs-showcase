{
  "name": "img2threejs-showcase",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "check:donate": "node scripts/check-donate-integrity.mjs",
    "prebuild": "npm run check:donate && npm run check:iphone-duo && npm run check:tropical-island && npm run build:living-room && npm run build:modern-bedroom",
    "dev": "vite",
    "build": "tsc --noEmit && node --max-old-space-size=8192 node_modules/vite/bin/vite.js build",
    "postbuild": "npm run check:tropical-island -- --dist && npm run test:source && node scripts/check-pages-size.mjs && npm run build:demos-json",
    "preview": "vite preview",
    "new-demo": "node scripts/new-showcase.mjs",
    "qa:export:list": "node scripts/qa-export-matrix.mjs --list",
    "qa:export:matrix": "node scripts/qa-export-matrix.mjs",
    "star-history": "node scripts/generate-star-history.mjs",
    "dev:iphone-duo": "vite --config vite.iphone-duo.config.ts",
    "build:iphone-duo": "npm run check:iphone-duo && tsc --noEmit -p tsconfig.iphone-duo.json && vite build --config vite.iphone-duo.config.ts",
    "preview:iphone-duo": "vite preview --config vite.iphone-duo.config.ts",
    "build:living-room": "npm run build --workspace @img2threejs/living-room -- --mode showcase --base=/living-room/ --outDir ../../public/living-room --emptyOutDir",
    "dev:living-room": "npm run dev --workspace @img2threejs/living-room",
    "preview:living-room": "npm run preview --workspace @img2threejs/living-room -- --mode showcase --base=/living-room/ --outDir ../../public/living-room",
    "sync:living-room": "node scripts/sync-living-room.mjs",
    "build:modern-bedroom": "npm run build --workspace @img2threejs/modern-bedroom -- --mode showcase --base=/modern-bedroom/ --outDir ../../public/modern-bedroom --emptyOutDir",
    "dev:modern-bedroom": "npm run dev --workspace @img2threejs/modern-bedroom",
    "preview:modern-bedroom": "npm run preview --workspace @img2threejs/modern-bedroom -- --mode showcase --base=/modern-bedroom/ --outDir ../../public/modern-bedroom",
    "publish:source": "node scripts/publish-source-archives.mjs",
    "test:source": "node --import tsx --test scripts/source-release.test.mjs tests/source-download.test.ts",
    "check:iphone-duo": "node scripts/check-iphone-duo-no-glb.mjs",
    "check:tropical-island": "node scripts/check-tropical-island-no-glb.mjs",
    "test:skybound": "tsx --test tests/skybound-adventure/simulation.test.ts",
    "build:demos-json": "node --import tsx scripts/demos-json.mjs dist/demos.json",
    "test:demos-json": "node --import tsx --test scripts/demos-json.test.mjs"
  },
  "dependencies": {
    "meshoptimizer": "~0.18.1",
    "pixi.js": "8.22.0",
    "three": "^0.169.0",
    "three-mesh-bvh": "^0.9.15"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "workspaces": [
    "showcases/living-room",
    "showcases/modern-bedroom"
  ]
}
