{
  "name": "img2threejs-showcase",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "check:donate": "node scripts/check-donate-integrity.mjs",
    "prebuild": "npm run check:donate && npm run check:iphone-duo && npm run check:tropical-island",
    "dev": "vite",
    "build": "tsc --noEmit && node --max-old-space-size=8192 node_modules/vite/bin/vite.js build",
    "postbuild": "npm run check:tropical-island -- --dist",
    "preview": "vite preview",
    "new-demo": "node scripts/new-showcase.mjs",
    "qa:export:list": "node scripts/qa-export-matrix.mjs --list",
    "qa:export:matrix": "node scripts/qa-export-matrix.mjs",
    "star-history": "node scripts/generate-star-history.mjs",
    "dev:iphone-duo": "vite --config vite.iphone-duo.config.ts",
    "build:iphone-duo": "npm run check:iphone-duo && tsc --noEmit -p tsconfig.iphone-duo.json && vite build --config vite.iphone-duo.config.ts",
    "preview:iphone-duo": "vite preview --config vite.iphone-duo.config.ts",
    "check:iphone-duo": "node scripts/check-iphone-duo-no-glb.mjs",
    "check:tropical-island": "node scripts/check-tropical-island-no-glb.mjs"
  },
  "dependencies": {
    "meshoptimizer": "~0.18.1",
    "pixi.js": "8.22.0",
    "three": "^0.169.0",
    "three-mesh-bvh": "^0.9.15"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
